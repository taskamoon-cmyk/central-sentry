# ------------------------------------------------------------------
# Central Sentry configuration. Copy to `.env` and edit:
#   cp .env.example .env
# ------------------------------------------------------------------

# Release of github.com/getsentry/self-hosted to deploy (pin it!).
SENTRY_VERSION=26.9.0

# Public domain Sentry will be served on. DNS A record must point here.
SENTRY_DOMAIN=sentry.example.com
# Email used by Let's Encrypt for certificate notices.
ACME_EMAIL=ops@example.com

# feature-complete = errors + performance + replays + profiling + crons + uptime (needs 16GB RAM, 4 CPU)
# errors-only      = just error tracking (needs ~8GB RAM, 2 CPU)
COMPOSE_PROFILES=feature-complete

# How long events are kept.
SENTRY_EVENT_RETENTION_DAYS=90

# Parallel task workers (more = more RAM).
SENTRY_TASKWORKER_CONCURRENCY=4

# Outgoing email for alerts / invites. Leave SMTP_HOST empty to use the
# bundled exim relay (often lands in spam; a real SMTP is recommended).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=sentry@example.com

# Where scripts/backup.sh writes backups, and how many days to keep them.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7

# Generated automatically on first install if empty.
LAUNCHPAD_RPC_SHARED_SECRET=
